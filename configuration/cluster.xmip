# The Essentials' cluster configuration: one file for a run on one computer
# and for the same cluster on machines of its own (the owner, 2026-10-21:
# *one TOML file that can be run for tests regardless of node faking or
# actual nodes*; ADR-0028, amendment 2026-10-21). It says what the cluster
# is — its nodes and their roles, where each reaches Xmip Storage and is
# operated from, its Parties and its Xmip Applications — and nothing of
# where it runs: no address of a machine, no absolute path, no cluster
# name. Those are the environment's. On one computer the run gives them:
# Start-XmipTest's -Cluster names the cluster, and the run gives each node it
# starts its addresses on loopback, its certificate from the run's
# authority and the bindings, whose addresses are the run's own
# directories (src/served.rs). On machines of their own
# the environment template gives them (deploy/dsc): `xmip-service
# --install --cluster` names the cluster, and each machine is given its
# node's slice of this file.
#
# A node finds the others by name: `DS1:7443` is the node DS1, resolved as
# every name is, never "this machine". A path is relative to the node's
# configuration file, so `tls/node.pem` is where the environment put this
# node's certificate, whatever machine it is on.

# Operated over gRPC at the node's address, on the operate plane's port,
# inside Xmip's mutual TLS (ADR-0014, ADR-0063); its local endpoint,
# xmip-<node>, always starts. The certificate is the node's, from the
# cluster's own authority; the anchors are that authority, which an
# operator's certificate must reach. Reaching them grants nothing: each
# caller holds the role its own name is listed with, and none where no list
# names it (ADR-0009, amendment 2026-11-07). On one computer the run lists
# the tester among every node's operators: the account it runs as, and the
# subject of every operator certificate the Essentials' authority signed
# (src/served/given.rs); on machines of their own the environment lists its
# operators' certificate subjects or accounts in `operators`.
[operate]
listen = "0.0.0.0:7401"
certificate = "tls/node.pem"
key = "tls/node.key"
anchors = "tls/anchors.pem"

# Xmip Storage, reached by name over Xmip's mutual TLS with the node's own
# certificate (ADR-0063; ADR-0067, amendment 2026-10-13). Only DS1 and DS2
# keep it, each serving it on the Storage plane's port; every other node
# reaches them (ADR-0056, amendment 2026-10-20). They are the primary and
# its standby, as they settle it, the first listed the first primary
# (ADR-0056, amendment 2026-10-22).
[storage]
nodes = ["DS1:7443", "DS2:7443"]
listen = "0.0.0.0:7443"
certificate = "tls/node.pem"
key = "tls/node.key"
anchors = "tls/anchors.pem"

# The nodes, named as the owner names them (ADR-0056, amendment 2026-11-12):
# RXn receiving, PXn processing, TXn sending, EXn executing, OPn operational
# and monitoring, DSn Storage. What each does is its roles, never its letters.

[nodes.RX1]
roles = "receiving"

[nodes.RX2]
roles = "receiving"

[nodes.PX1]
roles = "processing"

[nodes.TX1]
roles = "sending"

[nodes.TX2]
roles = "sending"

[nodes.EX1]
roles = "executing"

[nodes.OP1]
roles = "operational, monitoring"

[nodes.DS1]
roles = "storage"

[nodes.DS2]
roles = "storage"

# The Parties the cluster trades with (ADR-0019; ADR-0028, amendment
# 2026-10-13). Each sends into the Essentials over its share of the
# transports and is delivered to over another share, presenting the
# identity written here; the 50-second fault moves across them. Rename them
# here: nothing in the Essentials' code names a Party. Each Party is
# written with its id, a UUIDv7 minted once with it, and each identity
# with the mechanism that verifies it and what it is for (the owner,
# 2026-10-19).

[[parties]]
id = "01a1577b-4402-7ccf-8dbc-c2e0d7ec5189"
name = "Party-A"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-a.example" },
]

[[parties]]
id = "01a1577b-4418-7c64-8ea4-cd84a22a31f4"
name = "Party-B"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-b.example" },
]

[[parties]]
id = "01a1577b-441a-7aba-9cfa-9328e46f7004"
name = "Party-C"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-c.example" },
]

[[parties]]
id = "01a1577b-441b-7160-af1d-8d6bc087d827"
name = "Party-D"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-d.example" },
]

[[parties]]
id = "01a1577b-441c-7945-a51b-11efd67a0878"
name = "Party-E"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-e.example" },
]

# Two Xmip Applications (ADR-0064), each a business flow an ERP runs with
# its Parties: order to cash and procure to pay. The Parties trade real
# documents, UN/EDIFACT interchanges (`documents/`), and the company's ERP —
# played by the rig — sends its own to them through the ERP's Receive
# Locations and is delivered theirs through the "… to ERP" Send Ports. A
# Stream arrives at a node that declared receive, is published, and each
# Subscription picks up one kind of document and routes it to its Send Port
# by two properties promoted from the document itself, as a trading Party's
# documents are routed: the message type, `content:edi:UNH/2/1` (UNH S009
# 0065), and the recipient, `content:edi:UNB/3/1` (UNB S003 0010), which
# the `content` route technology reads through the `edi` path language
# (ADR-0046, amendment 2026-11-11). The names say what moves and with whom;
# what it moves over is each Location's transport, which the operation tools
# show from the configuration (the owner, 2026-10-13). An operator pauses
# and resumes these Subscriptions in the Subscriptions view (ADR-0013,
# amendment 2026-09-30); they are added and removed here, and nowhere else.

[[xmip_applications]]
name = "Order to cash"

[[xmip_applications.receive_ports]]
name = "Sales orders"

[[xmip_applications.receive_ports]]
name = "Remittance advices"

[[xmip_applications.receive_ports]]
name = "Order to cash documents from ERP"

[[xmip_applications.receive_locations]]
name = "Sales orders from Party-A"
receive_port = "Sales orders"
depth = "light"

[[xmip_applications.receive_locations]]
name = "Sales orders from Party-C"
receive_port = "Sales orders"
depth = "light"

[[xmip_applications.receive_locations]]
name = "Remittance advices from Party-E"
receive_port = "Remittance advices"
depth = "light"

# The ERP's order responses, dispatch advices and invoices, to the Parties.
[[xmip_applications.receive_locations]]
name = "Order to cash documents from ERP"
receive_port = "Order to cash documents from ERP"
depth = "light"

[[xmip_applications.send_ports]]
name = "Sales orders to ERP"

[[xmip_applications.send_ports]]
name = "Remittance advices to ERP"

[[xmip_applications.send_ports]]
name = "Order responses to Party-A"

[[xmip_applications.send_ports]]
name = "Dispatch advices to Party-A"

# A second Location for failover: the next is tried when the first has
# failed its retries.
[[xmip_applications.send_ports]]
name = "Invoices to Party-A"
send_locations = ["Invoices to Party-A", "Invoices to Party-A, failover"]
failover = "next"

[[xmip_applications.subscriptions]]
id = "Sales orders"
destination = { send-port = "Sales orders to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'ORDERS' and \"content:edi:UNB/3/1\" = 'ESSENTIALS'"

[[xmip_applications.subscriptions]]
id = "Remittance advices"
destination = { send-port = "Remittance advices to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'REMADV' and \"content:edi:UNB/3/1\" = 'ESSENTIALS'"

[[xmip_applications.subscriptions]]
id = "Order responses"
destination = { send-port = "Order responses to Party-A" }
filter = "\"content:edi:UNH/2/1\" = 'ORDRSP' and \"content:edi:UNB/3/1\" = 'PARTY-A'"

[[xmip_applications.subscriptions]]
id = "Dispatch advices"
destination = { send-port = "Dispatch advices to Party-A" }
filter = "\"content:edi:UNH/2/1\" = 'DESADV' and \"content:edi:UNB/3/1\" = 'PARTY-A'"

[[xmip_applications.subscriptions]]
id = "Invoices"
destination = { send-port = "Invoices to Party-A" }
filter = "\"content:edi:UNH/2/1\" = 'INVOIC' and \"content:edi:UNB/3/1\" = 'PARTY-A'"

[[xmip_applications]]
name = "Procure to pay"

[[xmip_applications.receive_ports]]
name = "Purchase order responses"

[[xmip_applications.receive_ports]]
name = "Goods receipts"

[[xmip_applications.receive_ports]]
name = "Inventory"

[[xmip_applications.receive_ports]]
name = "Procure to pay documents from ERP"

[[xmip_applications.receive_locations]]
name = "Purchase order responses from Party-B"
receive_port = "Purchase order responses"
depth = "light"

[[xmip_applications.receive_locations]]
name = "Goods receipts from Party-C"
receive_port = "Goods receipts"
depth = "light"

[[xmip_applications.receive_locations]]
name = "Inventory reports from Party-D"
receive_port = "Inventory"
depth = "light"

# The ERP's purchase orders, item master and payments, to the Parties.
[[xmip_applications.receive_locations]]
name = "Procure to pay documents from ERP"
receive_port = "Procure to pay documents from ERP"
depth = "light"

[[xmip_applications.send_ports]]
name = "Purchase order responses to ERP"

[[xmip_applications.send_ports]]
name = "Goods receipts to ERP"

[[xmip_applications.send_ports]]
name = "Inventory reports to ERP"

[[xmip_applications.send_ports]]
name = "Purchase orders to Party-B"

[[xmip_applications.send_ports]]
name = "Item master to Party-D"

[[xmip_applications.send_ports]]
name = "Payments to Party-E"

[[xmip_applications.subscriptions]]
id = "Purchase order responses"
destination = { send-port = "Purchase order responses to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'ORDRSP' and \"content:edi:UNB/3/1\" = 'ESSENTIALS'"

[[xmip_applications.subscriptions]]
id = "Goods receipts"
destination = { send-port = "Goods receipts to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'RECADV' and \"content:edi:UNB/3/1\" = 'ESSENTIALS'"

[[xmip_applications.subscriptions]]
id = "Inventory reports"
destination = { send-port = "Inventory reports to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'INVRPT' and \"content:edi:UNB/3/1\" = 'ESSENTIALS'"

[[xmip_applications.subscriptions]]
id = "Purchase orders"
destination = { send-port = "Purchase orders to Party-B" }
filter = "\"content:edi:UNH/2/1\" = 'ORDERS' and \"content:edi:UNB/3/1\" = 'PARTY-B'"

# The item master travels as a price catalogue, PRICAT.
[[xmip_applications.subscriptions]]
id = "Item master"
destination = { send-port = "Item master to Party-D" }
filter = "\"content:edi:UNH/2/1\" = 'PRICAT' and \"content:edi:UNB/3/1\" = 'PARTY-D'"

# Payments go to the bank as multiple payment orders, PAYMUL.
[[xmip_applications.subscriptions]]
id = "Payments"
destination = { send-port = "Payments to Party-E" }
filter = "\"content:edi:UNH/2/1\" = 'PAYMUL' and \"content:edi:UNB/3/1\" = 'PARTY-E'"